    "status",
    "usb status",
    "settings"
  ],
  "selfTestCommands": [
    "status",
    "usb status",
    "input status",
    "motion status",
    "rumble"
  ],
  "primaryStatusCommand": "status",
  "inputStatusCommand": "input status",
  "saveSettingsCommand": "settings save",
  "settingsCommandTemplates": [
    "rumble tune {rumbleScalePercent} {rumbleHoldMs} {rumbleTickMs} {rumbleStopPackets}",
    "usb rate {reportRateHz}",
    "usb raw {usbRaw}",
    "web parse {liveParsing}"
  ],
  "rumbleCommandTemplate": "rumble test {target}",
  "operations": {
    "mapping.read": {
      "transport": "ManagerCommand",
      "request": "mapping get {profile}"
    },
    "mapping.set": {
      "transport": "ManagerCommand",
      "request": "mapping set {profile} {target} {source}"
    },
    "mapping.reset": {
      "transport": "ManagerCommand",
      "request": "mapping reset {profile}"
    },
    "mapping.save": {
      "transport": "ManagerCommand",
      "request": "mapping save {profile}"
    },
    "device.reboot": {
      "transport": "ManagerCommand",
      "request": "reboot"
    },
    "settings.reset": {
      "transport": "ManagerCommand",
      "request": "settings reset"
    }
  },
  "pages": [
    {
      "id": "esp32s3-mapping",
      "label": "NS2Pro 按键映射",
      "description": "按物理输入保存一张完整映射表，适用于四种 USB 输出。当前输出不支持的扩展目标仍保留配置。",
      "icon": "Game",
      "sections": [
        {
          "id": "mapping-buttons",
          "label": "按键与扩展键",
          "controls": [
            {
              "id": "esp32s3-ns2pro-map",
              "type": "MappingEditor",
              "label": "NS2Pro 按键来源",
              "binding": "/entries",
              "mappingProfile": "ns2pro",
              "sourceCatalog": "controller.inputControls",
              "targetCatalog": "bridge.outputControls",
              "readAction": "mapping.read",
              "applyAction": "mapping.set",
              "resetAction": "mapping.reset",
              "saveAction": "mapping.save"
            }
          ]
        }
      ]
    },
    {
      "id": "esp32s3-recovery",
      "label": "ESP32-S3 恢复",
      "description": "设置恢复会清除已保存的手柄、输出与映射，并重新启动接收器。固件损坏时可按 BOOT + RESET 后从创建接收器页重新烧录。",
      "icon": "Settings",
      "sections": [
        {
          "id": "recovery-actions",
          "label": "设备恢复",
          "controls": [
            {
              "id": "esp32s3-reboot",
              "type": "ActionButton",
              "label": "重新启动接收器",
              "applyAction": "device.reboot"
            },
            {
              "id": "esp32s3-settings-reset",
              "type": "ActionButton",
              "label": "恢复默认设置并重启",
              "description": "清除保存的手柄与全部映射。",
              "applyAction": "settings.reset"
            }
          ]
        }
      ]
    }
  ]

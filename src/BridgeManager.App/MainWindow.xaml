<Window
    x:Class="BridgeManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SF32LB52 Bridge Manager">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh" Label="扫描设备" Click="RefreshDevices_Click" />
            <AppBarButton Icon="Link" Label="连接" Click="Connect_Click" />
            <AppBarButton Icon="DisconnectDrive" Label="断开" Click="Disconnect_Click" />
            <AppBarButton Icon="Save" Label="保存设置" Click="SaveSettings_Click" />
            <AppBarButton Icon="Accept" Label="测试全部功能" Click="TestAll_Click" />
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="14" Padding="18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="设备（推荐选择 USB HID）" FontSize="18" FontWeight="SemiBold" />
                <ListView x:Name="DeviceList" Grid.Row="1" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4" RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Text="{Binding TransportLabel}" Opacity="0.72" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" Text="USB HID 支持实时输入并会在角色重枚举后自动重连。串口仅用于诊断，不提供实时输入。" TextWrapping="Wrap" Opacity="0.72" />
            </Grid>

            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="140" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="10" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel><TextBlock Text="管理连接" Opacity="0.7" /><TextBlock x:Name="ConnectionText" Text="未连接" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="TransportText" Text="-" Opacity="0.7" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="10" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel><TextBlock Text="USB 角色" Opacity="0.7" /><TextBlock x:Name="RoleText" Text="-" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="10" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel><TextBlock Text="输入来源" Opacity="0.7" /><TextBlock x:Name="InputText" Text="-" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="InputPreferenceText" Text="偏好：-" Opacity="0.7" /></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Padding="10" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel><TextBlock Text="USB" Opacity="0.7" /><TextBlock x:Name="UsbText" Text="-" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                </Grid>

                <TabView Grid.Row="1" IsAddTabButtonVisible="False">
                    <TabViewItem Header="角色与连接" IsClosable="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="12" Spacing="14">
                                <TextBlock Text="USB 输出角色" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="XboxRoleButton" Content="Xbox 360" Click="SetXboxRole_Click" />
                                    <Button x:Name="Ds5RoleButton" Content="DualSense / DS5" Click="SetDs5Role_Click" />
                                    <Button x:Name="DseRoleButton" Content="DualSense Edge" Click="SetDseRole_Click" />
                                    <Button x:Name="Ns2RoleButton" Content="Nintendo NS2Pro" Click="SetNs2Role_Click" />
                                </StackPanel>
                                <TextBlock Text="无线输入选择" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="AutoInputButton" Content="自动" Click="SetInputAuto_Click" />
                                    <Button x:Name="Ds5InputButton" Content="只用 DS5" Click="SetInputDs5_Click" />
                                    <Button x:Name="Ns2InputButton" Content="只用 NS2Pro" Click="SetInputNs2_Click" />
                                </StackPanel>
                                <Border Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="DualSense / DS5（Bluetooth Classic）" FontWeight="SemiBold" />
                                        <TextBlock x:Name="Ds5StatusText" Text="未读取" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="配对" Click="PairDs5_Click" />
                                            <Button Content="连接" Click="ConnectDs5_Click" />
                                            <Button Content="断开" Click="DisconnectDs5_Click" />
                                            <Button Content="遗忘" Click="ForgetDs5_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Nintendo Switch 2 Pro（BLE）" FontWeight="SemiBold" />
                                        <TextBlock x:Name="Ns2StatusText" Text="未读取" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="配对/扫描" Click="PairNs2_Click" />
                                            <Button Content="连接" Click="ConnectNs2_Click" />
                                            <Button Content="断开" Click="DisconnectNs2_Click" />
                                            <Button Content="遗忘" Click="ForgetNs2_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <TabViewItem Header="输入与陀螺仪" IsClosable="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="12" Spacing="12">
                                <TextBlock x:Name="InputHealthText" Text="等待手柄输入" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="按下的按键" Opacity="0.7" />
                                <TextBlock x:Name="ButtonsText" Text="-" FontSize="18" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel><TextBlock Text="左摇杆" Opacity="0.7" /><TextBlock x:Name="LeftStickText" Text="X 0 / Y 0" FontSize="20" /></StackPanel></Border>
                                    <Border Grid.Column="1" Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel><TextBlock Text="右摇杆" Opacity="0.7" /><TextBlock x:Name="RightStickText" Text="X 0 / Y 0" FontSize="20" /></StackPanel></Border>
                                    <Border Grid.Column="2" Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel><TextBlock Text="扳机" Opacity="0.7" /><TextBlock x:Name="TriggersText" Text="L 0 / R 0" FontSize="20" /></StackPanel></Border>
                                </Grid>
                                <TextBlock x:Name="BatteryText" Text="电量：未知" />
                                <Border Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="六轴传感器（原始值）" FontWeight="SemiBold" />
                                        <TextBlock x:Name="AccelText" Text="Accel X 0 / Y 0 / Z 0" FontFamily="Cascadia Mono" />
                                        <TextBlock x:Name="GyroText" Text="Gyro  X 0 / Y 0 / Z 0" FontFamily="Cascadia Mono" />
                                    </StackPanel>
                                </Border>
                                <Button Content="立即刷新输入状态" HorizontalAlignment="Left" Click="RefreshInput_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <TabViewItem Header="震动与设置" IsClosable="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Padding="12" ColumnSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="震动转换测试" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="测试会发往当前活动输入；连接手柄后分别确认左右电机和双电机。" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RumbleStatusText" Text="活动输入：未读取；震动计数：不可用" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="左电机" Click="RumbleLeft_Click" />
                                        <Button Content="右电机" Click="RumbleRight_Click" />
                                        <Button Content="双电机" Click="RumbleTest_Click" />
                                        <Button Content="停止" Click="RumbleStop_Click" />
                                    </StackPanel>
                                    <NumberBox x:Name="ScaleBox" Header="NS2Pro 震动倍率 %" Minimum="5" Maximum="250" Value="60" />
                                    <NumberBox x:Name="HoldBox" Header="保持时间 ms" Minimum="20" Maximum="3000" Value="140" />
                                    <NumberBox x:Name="TickBox" Header="转发间隔 ms" Minimum="5" Maximum="100" Value="30" />
                                    <NumberBox x:Name="StopsBox" Header="停止包数量" Minimum="1" Maximum="12" Value="3" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="USB 与诊断设置" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AudioStatusText" Text="DS5 音频：未读取" TextWrapping="Wrap" />
                                    <Button Content="刷新 DS5 音频流计数" HorizontalAlignment="Left" Click="RefreshUsbAudio_Click" />
                                    <TextBlock Text="将 Windows 输出切换到 Wireless Controller 并播放声音；OUT 包/字节持续增加才代表主机真正打开并发送了音频流。" TextWrapping="Wrap" Opacity="0.72" />
                                    <NumberBox x:Name="RateBox" Header="USB 回报率 Hz" Minimum="60" Maximum="1000" Value="250" />
                                    <ToggleSwitch x:Name="RawSwitch" Header="Raw USB 诊断" />
                                    <ToggleSwitch x:Name="ParseSwitch" Header="实时解析" IsOn="True" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="应用" Click="ApplySettings_Click" />
                                        <Button Content="保存到设备" Click="SaveSettings_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabViewItem>

                    <TabViewItem Header="完整自检与 JSON" IsClosable="False">
                        <Grid Padding="12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="8">
                                <Button Content="运行全部自动检查" HorizontalAlignment="Left" Click="TestAll_Click" />
                                <TextBlock Text="自动检查：管理通道、USB/UAC、配置、DS5/NS2 状态、统一输入和六轴数据接口。APP 的左右/双电机按钮会按当前无线输入测试 DS5 或 NS2Pro；实体按键、震感和音频仍需人工确认。" TextWrapping="Wrap" />
                                <TextBlock Text="当前诊断摘要" FontWeight="SemiBold" />
                                <TextBox x:Name="DiagnosticsBox" MinHeight="120" AcceptsReturn="True" IsReadOnly="True" FontFamily="Cascadia Mono" TextWrapping="Wrap" />
                                <TextBox x:Name="TestResultBox" MinHeight="280" AcceptsReturn="True" IsReadOnly="True" FontFamily="Cascadia Mono" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="最近一次 JSON" FontWeight="SemiBold" />
                                <TextBox x:Name="JsonBox" MinHeight="330" AcceptsReturn="True" IsReadOnly="True" FontFamily="Cascadia Mono" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </TabViewItem>
                </TabView>

                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="CommandBox" Text="bridge status" PlaceholderText="输入 manager 命令" />
                    <Button Grid.Column="1" Content="发送" Click="SendRawCommand_Click" />
                </Grid>
                <TextBox x:Name="LogBox" Grid.Row="3" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Cascadia Mono" IsReadOnly="True" />
            </Grid>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="True" Severity="Informational" Title="Bridge Manager" Message="先扫描并连接设备。" />
    </Grid>
</Window>

<UserControl
    x:Class="BridgeManager.Modern.SetupWizardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BridgeManager.Modern">
    <UserControl.Resources>
        <local:CreationBoardDescriptionConverter x:Key="CreationBoardDescription" />
        <Style x:Key="CreationCardStyle" TargetType="GridViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource BridgeStrokeBrush}" />
            <Setter Property="Background" Value="{ThemeResource BridgeSurfaceBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="WizardLayout" Background="{ThemeResource BridgeSurfaceBrush}">
        <Grid x:Name="WizardContent" Padding="28,24,16,20" RowSpacing="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid x:Name="WizardHeader" Margin="0,0,12,0">
                <StackPanel Spacing="6" HorizontalAlignment="Center" MaxWidth="720">
                    <TextBlock x:Name="WizardStepTitle" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="WizardStepSubtitle" TextAlignment="Center" Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="WizardScroller" Grid.Row="1" VerticalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" ZoomMode="Disabled">
                <Grid>
                    <StackPanel x:Name="WizardWelcomePanel" Spacing="18" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="680" Margin="16,24,28,24">
                        <Border Width="64" Height="64" CornerRadius="9" Background="{StaticResource BridgeAccentSoftBrush}" BorderBrush="{ThemeResource BridgeAccentBrush}" BorderThickness="1" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE9D9;" FontSize="28" Foreground="{ThemeResource BridgeAccentInkBrush}" />
                        </Border>
                        <TextBlock x:Name="WizardWelcomeTitle" Text="把板卡变成你需要的控制器桥接器" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="选择板卡和固件，完成烧录与配置，即可连接你的无线手柄。" Style="{StaticResource QuietCaptionStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="WizardStartButton" HorizontalAlignment="Center" Click="WizardStart_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="开始设置" /><SymbolIcon Symbol="Forward" /></StackPanel>
                        </Button>
                        <CheckBox x:Name="WizardDontShowAgainCheckBox" Content="下次启动不再自动进入创建接收器" HorizontalAlignment="Center" Margin="0,6,0,0" Checked="WizardStartupPreference_Changed" Unchecked="WizardStartupPreference_Changed" />
                    </StackPanel>
                    <StackPanel x:Name="WizardBoardPanel" Visibility="Collapsed" Spacing="20">
                        <Expander x:Name="DetectedDeviceExpander" Header="自动识别板卡（可选）" IsExpanded="False" Margin="0,0,12,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="检测到的设备" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Click="RefreshDetectedDevices_Click" ToolTipService.ToolTip="重新枚举 USB HID 与串口" AutomationProperties.Name="刷新检测到的设备"><SymbolIcon Symbol="Refresh" /></Button>
                                </Grid>
                                <TextBlock x:Name="DetectedDeviceStatusText" Text="正在读取 Windows 设备枚举结果..." Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" />
                                <ListView x:Name="DetectedDeviceList" MaxHeight="140" SelectionMode="Single" SelectionChanged="DetectedDeviceList_SelectionChanged">
                                    <ListView.ItemTemplate><DataTemplate>
                                        <StackPanel Padding="8" Spacing="3"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Detail}" Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" /></StackPanel>
                                    </DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander>
                        <GridView x:Name="WizardBoardList" SelectionMode="Single" IsItemClickEnabled="False" ItemContainerStyle="{StaticResource CreationCardStyle}" SelectionChanged="WizardBoardList_SelectionChanged" ContainerContentChanging="CreationCard_ContentChanging" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="选择接收器板卡">
                            <GridView.ItemsPanel><ItemsPanelTemplate><local:ResponsiveItemsPanel ItemMinWidth="300" MaxColumns="2" /></ItemsPanelTemplate></GridView.ItemsPanel>
                            <GridView.ItemTemplate><DataTemplate>
                                <Grid MinHeight="148" Padding="24">
                                    <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding Family}" TextAlignment="Center" Style="{StaticResource QuietCaptionStyle}" />
                                        <TextBlock Text="{Binding DisplayName}" TextAlignment="Center" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Converter={StaticResource CreationBoardDescription}}" TextAlignment="Center" Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate></GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                    <StackPanel x:Name="WizardFirmwarePanel" Visibility="Collapsed" Spacing="14">
                        <Grid Margin="0,0,12,0" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <Button Click="ImportModuleFile_Click" Content="导入 .cbmodule" />
                                <Button Click="RefreshGithubModules_Click" Content="从 GitHub 获取" />
                            </StackPanel>
                        </Grid>
                        <GridView x:Name="WizardFirmwareList" SelectionMode="Single" ItemContainerStyle="{StaticResource CreationCardStyle}" SelectionChanged="WizardFirmwareList_SelectionChanged" ContainerContentChanging="CreationCard_ContentChanging" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="选择兼容固件">
                            <GridView.ItemsPanel><ItemsPanelTemplate><local:ResponsiveItemsPanel ItemMinWidth="300" MaxColumns="2" /></ItemsPanelTemplate></GridView.ItemsPanel>
                            <GridView.ItemTemplate><DataTemplate>
                                <Grid Padding="24" MinHeight="160">
                                    <StackPanel Spacing="10" VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Version}" TextAlignment="Center" Style="{StaticResource QuietCaptionStyle}" />
                                        <TextBlock Text="{Binding Description}" TextAlignment="Center" Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Availability}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate></GridView.ItemTemplate>
                        </GridView>
                        <Border x:Name="GithubModulesPanel" Visibility="Collapsed" Margin="0,0,12,0" Style="{StaticResource BridgeCardStyle}" Padding="14">
                            <StackPanel Spacing="10">
                                <Grid><TextBlock Text="GitHub Release 兼容包" FontWeight="SemiBold" /><ProgressRing x:Name="GithubProgressRing" HorizontalAlignment="Right" Width="20" Height="20" IsActive="False" /></Grid>
                                <TextBlock x:Name="GithubStatusText" Text="尚未刷新" Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" />
                                <ListView x:Name="GithubModuleList" MaxHeight="150" SelectionMode="Single" SelectionChanged="GithubModuleList_SelectionChanged" DisplayMemberPath="DisplayName" />
                                <Button x:Name="InstallGithubModuleButton" Content="安装所选兼容包" IsEnabled="False" HorizontalAlignment="Left" Click="InstallGithubModule_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="WizardFlashPanel" Visibility="Collapsed" Spacing="16" Margin="0,0,12,0" MaxWidth="760" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource BridgeCardStyle}" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="WizardFlashMethodText" Text="-" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="WizardFlashHintText" Text="请选择固件" TextWrapping="Wrap" />
                                <TextBlock x:Name="WizardArtifactText" Text="固件文件：-" Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" />
                                <Expander Header="文件校验与工具" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="8"><TextBlock x:Name="WizardFirmwareHashText" Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /><TextBlock x:Name="WizardFlashToolText" Text="烧录工具：-" TextWrapping="Wrap" /></StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <Grid x:Name="WizardPortPanel" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="WizardPortBox" Header="下载串口" PlaceholderText="选择 COM 端口" HorizontalAlignment="Stretch" />
                            <Button x:Name="WizardRefreshPortsButton" Grid.Column="1" VerticalAlignment="Bottom" Click="RefreshWizardPorts_Click" ToolTipService.ToolTip="刷新 Windows 下载串口"><SymbolIcon Symbol="Refresh" /></Button>
                        </Grid>
                        <ProgressRing x:Name="WizardFlashProgress" Width="24" Height="24" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" />
                        <TextBlock x:Name="WizardFlashStatusText" Text="尚未检查烧录环境" TextWrapping="Wrap" Style="{StaticResource QuietCaptionStyle}" />
                        <ItemsControl x:Name="WizardFlashActions" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:ResponsiveItemsPanel ItemMinWidth="170" MaxColumns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <Button x:Name="WizardCheckFlashButton" Margin="0,0,8,8" HorizontalAlignment="Stretch" Click="WizardCheckFlash_Click" Content="检查环境" />
                            <Button x:Name="WizardFlashButton" Margin="0,0,8,8" HorizontalAlignment="Stretch" Click="WizardFlash_Click" IsEnabled="False" Style="{StaticResource BridgePrimaryButtonStyle}" Content="开始烧录" />
                            <Button x:Name="WizardSkipFlashButton" Margin="0,0,8,8" HorizontalAlignment="Stretch" Click="WizardSkipFlash_Click" Content="已有固件，跳过" />
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel x:Name="WizardSettingsPanel" Visibility="Collapsed" Spacing="16" Margin="0,0,12,0" MaxWidth="640" HorizontalAlignment="Stretch">
                        <ComboBox x:Name="WizardRoleBox" Header="电脑中的手柄身份" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
                        <ComboBox x:Name="WizardInputBox" Header="无线输入偏好" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
                        <NumberBox x:Name="WizardRateBox" Header="USB 回报率 Hz" Minimum="60" Maximum="1000" Value="250" SpinButtonPlacementMode="Compact" />
                        <CheckBox x:Name="WizardSaveSettingsCheck" Content="连接设备后保存到固件" IsChecked="True" />
                        <TextBlock Text="设备尚未连接时，这些选择会保存在本机。" Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="WizardDonePanel" Visibility="Collapsed" Spacing="16" Margin="16,24,28,24" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
                        <SymbolIcon Symbol="Accept" Foreground="{ThemeResource BridgeAccentInkBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="WizardDoneText" Text="现在可以连接设备并开始使用。" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="进入输入测试检查按键和摇杆，再按需测试震动与音频。" TextAlignment="Center" Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Grid x:Name="WizardFooter" Grid.Row="2" RowSpacing="18" Padding="0,16,12,0" BorderBrush="{ThemeResource BridgeStrokeBrush}" BorderThickness="0,1,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid x:Name="WizardFooterActions">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button x:Name="WizardBackButton" Content="上一步" Click="WizardBack_Click" Visibility="Collapsed" />
                    <Button x:Name="WizardNextButton" Grid.Column="2" Content="开始创建" Style="{StaticResource BridgePrimaryButtonStyle}" Click="WizardNext_Click" />
                </Grid>
                <StackPanel x:Name="WizardProgress" Grid.Row="1" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center" AutomationProperties.Name="创建进度">
                    <Border x:Name="Step1Indicator" Height="9" Width="9" CornerRadius="5" BorderThickness="1.5" BorderBrush="{ThemeResource BridgeAccentInkBrush}" ToolTipService.ToolTip="准备" />
                    <Border x:Name="Step2Indicator" Height="9" Width="9" CornerRadius="5" BorderThickness="1.5" BorderBrush="{ThemeResource BridgeAccentInkBrush}" ToolTipService.ToolTip="选择板卡" />
                    <Border x:Name="Step3Indicator" Height="9" Width="9" CornerRadius="5" BorderThickness="1.5" BorderBrush="{ThemeResource BridgeAccentInkBrush}" ToolTipService.ToolTip="选择固件" />
                    <Border x:Name="Step4Indicator" Height="9" Width="9" CornerRadius="5" BorderThickness="1.5" BorderBrush="{ThemeResource BridgeAccentInkBrush}" ToolTipService.ToolTip="烧录" />
                    <Border x:Name="Step5Indicator" Height="9" Width="9" CornerRadius="5" BorderThickness="1.5" BorderBrush="{ThemeResource BridgeAccentInkBrush}" ToolTipService.ToolTip="基本设置" />
                    <Border x:Name="Step6Indicator" Height="9" Width="9" CornerRadius="5" BorderThickness="1.5" BorderBrush="{ThemeResource BridgeAccentInkBrush}" ToolTipService.ToolTip="完成" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

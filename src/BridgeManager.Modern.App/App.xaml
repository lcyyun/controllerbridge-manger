<Application
    x:Class="BridgeManager.Modern.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BridgePageBrush" Color="#FAFBFC" />
                    <SolidColorBrush x:Key="BridgePaneBrush" Color="#F1F3F4" />
                    <SolidColorBrush x:Key="BridgeSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BridgeInsetBrush" Color="#F0F2F4" />
                    <SolidColorBrush x:Key="BridgeTextBrush" Color="#222629" />
                    <SolidColorBrush x:Key="BridgeSecondaryTextBrush" Color="#626B72" />
                    <SolidColorBrush x:Key="BridgeStrokeBrush" Color="#DFE3E6" />
                    <SolidColorBrush x:Key="BridgeAccentInkBrush" Color="#087F73" />
                    <SolidColorBrush x:Key="BridgeDangerInkBrush" Color="#BB3047" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BridgePageBrush" Color="#1D1F21" />
                    <SolidColorBrush x:Key="BridgePaneBrush" Color="#181A1C" />
                    <SolidColorBrush x:Key="BridgeSurfaceBrush" Color="#272A2D" />
                    <SolidColorBrush x:Key="BridgeInsetBrush" Color="#24272A" />
                    <SolidColorBrush x:Key="BridgeTextBrush" Color="#F2F4F5" />
                    <SolidColorBrush x:Key="BridgeSecondaryTextBrush" Color="#ADB5BC" />
                    <SolidColorBrush x:Key="BridgeStrokeBrush" Color="#3B4044" />
                    <SolidColorBrush x:Key="BridgeAccentInkBrush" Color="#61D6C6" />
                    <SolidColorBrush x:Key="BridgeDangerInkBrush" Color="#FF8697" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="BridgePageBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="BridgePaneBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="BridgeSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="BridgeInsetBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="BridgeTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="BridgeSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="BridgeStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="BridgeAccentInkBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="BridgeDangerInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="BridgeUIFontFamily">Segoe UI Variable Text</FontFamily>
            <SolidColorBrush x:Key="BridgeAccentBrush" Color="#26A69A" />
            <SolidColorBrush x:Key="BridgeAccentSoftBrush" Color="#1826A69A" />
            <SolidColorBrush x:Key="XboxBrush" Color="#3FA34D" />
            <SolidColorBrush x:Key="SonyBrush" Color="#2F80ED" />
            <SolidColorBrush x:Key="EdgeBrush" Color="#8E6BBE" />
            <SolidColorBrush x:Key="NintendoBrush" Color="#E84A5F" />
            <Style x:Key="BridgeBodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BridgeUIFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CharacterSpacing" Value="0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="BridgePageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BridgeBodyTextStyle}">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="LineHeight" Value="34" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BridgeBodyTextStyle}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="LineHeight" Value="24" />
            </Style>
            <Style x:Key="QuietCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource BridgeBodyTextStyle}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource BridgeSecondaryTextBrush}" />
                <Setter Property="LineHeight" Value="18" />
            </Style>
            <Style x:Key="BridgeMetricStyle" TargetType="TextBlock" BasedOn="{StaticResource BridgeBodyTextStyle}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="BridgeMonoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BridgeBodyTextStyle}">
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="20" />
            </Style>
            <Style x:Key="RoleButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="80" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource BridgeStrokeBrush}" />
                <Setter Property="Background" Value="{ThemeResource BridgeSurfaceBrush}" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
            <Style x:Key="BridgePageScrollStyle" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="HorizontalScrollMode" Value="Disabled" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalScrollMode" Value="Enabled" />
                <Setter Property="ZoomMode" Value="Disabled" />
                <Setter Property="IsVerticalScrollChainingEnabled" Value="True" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Padding" Value="0,0,12,28" />
            </Style>
            <Style x:Key="BridgeSectionExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="0,8,0,20" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource BridgeStrokeBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style x:Key="BridgeDiagnosticTextBoxStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="{ThemeResource BridgeInsetBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource BridgeStrokeBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource BridgeTextBrush}" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

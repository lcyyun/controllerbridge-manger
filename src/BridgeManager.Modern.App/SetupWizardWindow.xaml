<Window
    x:Class="BridgeManager.Modern.SetupWizardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Controller Bridge 设置向导">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource BridgeAccentSoftBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Grid Padding="28,30,24,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="12">
                    <Border Width="44" Height="44" HorizontalAlignment="Left"
                            CornerRadius="8" Background="{StaticResource BridgeAccentBrush}">
                        <FontIcon Glyph="&#xE7FC;" FontSize="22" Foreground="White" />
                    </Border>
                    <TextBlock Text="Controller Bridge" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="设备设置向导" Opacity="0.66" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="18">
                    <StackPanel x:Name="Step1Indicator" Orientation="Horizontal" Spacing="10">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BridgeAccentBrush}"><TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="欢迎" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel x:Name="Step2Indicator" Orientation="Horizontal" Spacing="10" Opacity="0.45">
                        <Border Width="28" Height="28" CornerRadius="8" BorderBrush="{StaticResource BridgeAccentBrush}" BorderThickness="1"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="选择板卡" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="Step3Indicator" Orientation="Horizontal" Spacing="10" Opacity="0.45">
                        <Border Width="28" Height="28" CornerRadius="8" BorderBrush="{StaticResource BridgeAccentBrush}" BorderThickness="1"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="选择固件" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="Step4Indicator" Orientation="Horizontal" Spacing="10" Opacity="0.45">
                        <Border Width="28" Height="28" CornerRadius="8" BorderBrush="{StaticResource BridgeAccentBrush}" BorderThickness="1"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="烧录" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="Step5Indicator" Orientation="Horizontal" Spacing="10" Opacity="0.45">
                        <Border Width="28" Height="28" CornerRadius="8" BorderBrush="{StaticResource BridgeAccentBrush}" BorderThickness="1"><TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="基本设置" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="Step6Indicator" Orientation="Horizontal" Spacing="10" Opacity="0.45">
                        <Border Width="28" Height="28" CornerRadius="8" BorderBrush="{StaticResource BridgeAccentBrush}" BorderThickness="1"><TextBlock Text="6" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="开始使用" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="固件功能由可独立更新的模块提供。"
                           Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Padding="34,28,34,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="WizardStepTitle" Text="欢迎使用 Controller Bridge" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock x:Name="WizardStepSubtitle" Text="用几步完成板卡、固件和手柄设置" Opacity="0.68" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="WizardStepCounter" Grid.Column="1" Text="步骤 1 / 6" VerticalAlignment="Center" FontWeight="SemiBold" />
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,22,0,16" VerticalScrollBarVisibility="Auto">
                <Grid MinHeight="470">
                    <StackPanel x:Name="WizardWelcomePanel" Spacing="18" VerticalAlignment="Center" MaxWidth="620" HorizontalAlignment="Center">
                        <Border Width="72" Height="72" CornerRadius="8" Background="{StaticResource BridgeAccentSoftBrush}" BorderBrush="{StaticResource BridgeAccentBrush}" BorderThickness="1">
                            <FontIcon Glyph="&#xE9D9;" FontSize="34" Foreground="{StaticResource BridgeAccentBrush}" />
                        </Border>
                        <TextBlock Text="把板卡变成你需要的控制器桥接器" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="选择硬件和固件后，向导只会显示当前模块真正支持的身份、无线输入与设置。" FontSize="15" Opacity="0.72" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button HorizontalAlignment="Center" Click="WizardStart_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="开始设置" /><SymbolIcon Symbol="Forward" /></StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="WizardBoardPanel" Visibility="Collapsed" Spacing="12">
                        <Grid>
                            <TextBlock Text="Windows 实际检测到的设备" Style="{StaticResource SectionTitleStyle}" />
                            <Button HorizontalAlignment="Right" Click="RefreshDetectedDevices_Click" ToolTipService.ToolTip="重新枚举 USB HID 与串口">
                                <SymbolIcon Symbol="Refresh" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="DetectedDeviceStatusText" Text="正在读取 Windows 设备枚举结果..." Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" />
                        <ListView x:Name="DetectedDeviceList" MaxHeight="170" SelectionMode="Single" SelectionChanged="DetectedDeviceList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="12,9" Spacing="3">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Border Height="1" Margin="0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock Text="手动选择板卡" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="仅在设备尚未烧录管理固件、无法通过 USB 身份判断板型时使用。" Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" />
                        <ListView x:Name="WizardBoardList" SelectionMode="Single" SelectionChanged="WizardBoardList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="14" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="7" Background="{StaticResource BridgeAccentSoftBrush}"><FontIcon Glyph="&#xE950;" Foreground="{StaticResource BridgeAccentBrush}" /></Border>
                                        <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="{Binding Family}" Style="{StaticResource QuietCaptionStyle}" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.72" /></StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel x:Name="WizardFirmwarePanel" Visibility="Collapsed" Spacing="12">
                        <Grid>
                            <TextBlock Text="随包固件" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <Button Click="ImportModuleFile_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="OpenFile" /><TextBlock Text="导入 .cbmodule" /></StackPanel></Button>
                                <Button Click="RefreshGithubModules_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Sync" /><TextBlock Text="从 GitHub 获取" /></StackPanel></Button>
                            </StackPanel>
                        </Grid>
                        <ListView x:Name="WizardFirmwareList" SelectionMode="Single" SelectionChanged="WizardFirmwareList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="14" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="{Binding ModuleName}" Style="{StaticResource QuietCaptionStyle}" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.72" /><TextBlock Text="{Binding Availability}" TextWrapping="Wrap" FontWeight="SemiBold" /></StackPanel>
                                        <Border Grid.Column="1" Padding="8,4" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Top"><TextBlock Text="{Binding Version}" /></Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Border x:Name="GithubModulesPanel" Visibility="Collapsed" Padding="14" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <TextBlock Text="GitHub Release 中的单文件兼容包" FontWeight="SemiBold" />
                                    <ProgressRing x:Name="GithubProgressRing" HorizontalAlignment="Right" Width="20" Height="20" IsActive="False" />
                                </Grid>
                                <TextBlock x:Name="GithubStatusText" Text="尚未刷新" Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" />
                                <ListView x:Name="GithubModuleList" MaxHeight="150" SelectionMode="Single" SelectionChanged="GithubModuleList_SelectionChanged" DisplayMemberPath="DisplayName" />
                                <Button x:Name="InstallGithubModuleButton" Content="安装所选兼容包" IsEnabled="False" HorizontalAlignment="Left" Click="InstallGithubModule_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="WizardFlashPanel" Visibility="Collapsed" Spacing="16">
                        <Border Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <Grid><TextBlock Text="烧录方式" Opacity="0.66" /><TextBlock x:Name="WizardFlashMethodText" Text="-" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                <TextBlock x:Name="WizardFlashHintText" Text="请选择固件" TextWrapping="Wrap" />
                                <TextBlock x:Name="WizardArtifactText" Text="固件文件：-" Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="WizardFirmwareHashText" Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock x:Name="WizardFlashToolText" Text="烧录工具：-" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Grid x:Name="WizardPortPanel" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="WizardPortBox" Header="下载串口" PlaceholderText="选择 COM 端口" HorizontalAlignment="Stretch" />
                            <Button x:Name="WizardRefreshPortsButton" Grid.Column="1" VerticalAlignment="Bottom" Click="RefreshWizardPorts_Click" ToolTipService.ToolTip="刷新 Windows 下载串口"><SymbolIcon Symbol="Refresh" /></Button>
                        </Grid>
                        <ProgressRing x:Name="WizardFlashProgress" Width="24" Height="24" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" />
                        <TextBlock x:Name="WizardFlashStatusText" Text="尚未检查烧录环境" TextWrapping="Wrap" Opacity="0.72" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="WizardCheckFlashButton" Click="WizardCheckFlash_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Refresh" /><TextBlock Text="检查环境" /></StackPanel></Button>
                            <Button x:Name="WizardFlashButton" Click="WizardFlash_Click" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Download" /><TextBlock Text="开始烧录" /></StackPanel></Button>
                            <Button x:Name="WizardSkipFlashButton" Click="WizardSkipFlash_Click" Content="已有固件，跳过" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="WizardSettingsPanel" Visibility="Collapsed" Spacing="16">
                        <TextBlock Text="基本设置" Style="{StaticResource SectionTitleStyle}" />
                        <ComboBox x:Name="WizardRoleBox" Header="电脑中的手柄身份" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
                        <ComboBox x:Name="WizardInputBox" Header="无线输入偏好" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
                        <NumberBox x:Name="WizardRateBox" Header="USB 回报率 Hz" Minimum="60" Maximum="1000" Value="250" SpinButtonPlacementMode="Compact" />
                        <CheckBox x:Name="WizardSaveSettingsCheck" Content="连接设备后保存到固件" IsChecked="True" />
                        <TextBlock Text="设备尚未连接时，这些选择会保存在本机。" Style="{StaticResource QuietCaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="WizardDonePanel" Visibility="Collapsed" Spacing="18" VerticalAlignment="Center" MaxWidth="620" HorizontalAlignment="Center">
                        <SymbolIcon Symbol="Accept" Foreground="{StaticResource BridgeAccentBrush}" Width="48" Height="48" />
                        <TextBlock Text="准备完成" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="WizardDoneText" Text="现在可以连接设备并开始使用。" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.72" />
                        <Button Click="WizardFinish_Click" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="进入管理器" /><SymbolIcon Symbol="Forward" /></StackPanel></Button>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="WizardBackButton" Content="上一步" Click="WizardBack_Click" Visibility="Collapsed" />
                <Button x:Name="WizardNextButton" Grid.Column="2" Content="下一步" Click="WizardNext_Click" Visibility="Collapsed" />
            </Grid>

            <InfoBar x:Name="WizardInfoBar" Grid.Row="3" Margin="0,16,0,0" IsOpen="False" IsClosable="True" Title="设置向导" />
        </Grid>
    </Grid>
</Window>
